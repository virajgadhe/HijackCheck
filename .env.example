# Copy to .env and fill in locally. Never commit .env.
SECRET_KEY=replace-with-a-random-value
GOOGLE_API_KEY=
# GEMINI_API_KEY= # accepted as an alternative to GOOGLE_API_KEY
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_MAX_OUTPUT_TOKENS=4096
# MINIMAL suppresses Gemma thought parts that otherwise consume the output budget.
GEMMA_THINKING_LEVEL=MINIMAL
# Abort a stalled model request instead of waiting indefinitely.
GEMMA_REQUEST_TIMEOUT_MS=90000
EXTRACTION_TIMEOUT_MS=25000

# Legacy /api/baseline only. Capture and security-mode routes permit only the exact attack URL.
ALLOW_PRIVATE_URLS=false
